{
  "expo": {
    "name": "ScribeZero",
    "slug": "scribezero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "scribezero",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hushtunnel.scribezero",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ScribeZero needs microphone access to record audio memos for on-device transcription."
      }
    },
    "android": {
      "package": "com.hushtunnel.scribezero",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}